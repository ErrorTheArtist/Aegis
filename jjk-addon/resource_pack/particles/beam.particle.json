{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/orb"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(variable.len * 4, 2, 160)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.dx * math.random(0, variable.len) + math.random(-0.06, 0.06)",
          "variable.dy * math.random(0, variable.len) + math.random(-0.06, 0.06)",
          "variable.dz * math.random(0, variable.len) + math.random(-0.06, 0.06)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.45)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.random(0.18, 0.3) * (variable.size > 0 ? variable.size : 1)",
          "math.random(0.18, 0.3) * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
