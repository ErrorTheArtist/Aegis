{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/orb"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(80, 22 * (variable.size > 0 ? variable.size : 1))"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * (variable.size > 0 ? variable.size : 1)",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 8) * (variable.size > 0 ? variable.size : 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.random(0.15, 0.35) * (variable.size > 0 ? variable.size : 1)",
          "math.random(0.15, 0.35) * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
