{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:fish",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/jjk/fish"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(14, 8 * (variable.size > 0 ? variable.size : 1))"
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.1)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 420) * (0.6 + v.particle_random_2 * 0.9) * (variable.size > 0 ? variable.size : 1)",
          "(v.particle_random_3 - 0.5) * 1.2 * (variable.size > 0 ? variable.size : 1)",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 420) * (0.6 + v.particle_random_2 * 0.9) * (variable.size > 0 ? variable.size : 1)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.26 * (variable.size > 0 ? variable.size : 1)",
          "0.26 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "math.min(1, (1 - v.particle_age / v.particle_lifetime) * 3)"
        ]
      }
    }
  }
}
