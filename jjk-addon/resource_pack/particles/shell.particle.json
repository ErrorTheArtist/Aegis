{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:shell",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/orb"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(variable.radius * variable.radius * 1.4, 20, 260)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.6)"
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 * (variable.size > 0 ? variable.size : 1)",
          "0.35 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
