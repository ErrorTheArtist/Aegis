{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/spark"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(40, 12 * (variable.size > 0 ? variable.size : 1))"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.2, 0.4)"
      },
      "minecraft:particle_initial_speed": "math.random(6, 12) * (variable.size > 0 ? variable.size : 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06",
          "0.45 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        },
        "direction": {
          "mode": "derive_from_velocity"
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
