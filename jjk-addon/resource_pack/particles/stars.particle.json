{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:stars",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/spark"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(variable.radius * 3, 10, 40)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.2, 2.2)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_initial_spin": {
        "rotation": 45
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * (variable.size > 0 ? variable.size : 1)",
          "0.12 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "math.sin(v.particle_age / v.particle_lifetime * 180)"
        ]
      }
    }
  }
}
