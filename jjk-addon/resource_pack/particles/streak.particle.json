{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:streak",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/spark"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5 * (variable.size > 0 ? variable.size : 1)",
        "direction": [
          "-variable.dx",
          "-variable.dy",
          "-variable.dz"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.3)"
      },
      "minecraft:particle_initial_speed": "math.random(8, 14)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.05",
          "0.9 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        },
        "direction": {
          "mode": "derive_from_velocity"
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
