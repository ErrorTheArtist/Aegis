{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk/orb"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.6
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 720) * variable.radius * (1 - v.particle_age / v.particle_lifetime)",
          "(v.particle_random_2 - 0.5) * variable.radius * 0.6 * (1 - v.particle_age / v.particle_lifetime)",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 720) * variable.radius * (1 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (variable.size > 0 ? variable.size : 1)",
          "0.18 * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
