      "aegis:wander": {
        "remove": {
          "component_groups": [
            "aegis:stay"
          ]
        },
        "add": {
          "component_groups": [
            "aegis:wander"
          ]
        }
      },
      "aegis:invulnerable": {
        "add": {
          "component_groups": [
            "aegis:invulnerable"
          ]
        }
      },
      "aegis:vulnerable": {
        "remove": {
          "component_groups": [
            "aegis:invulnerable"
          ]
        }
      },
      "aegis:persist": {
        "remove": {
          "component_groups": [
