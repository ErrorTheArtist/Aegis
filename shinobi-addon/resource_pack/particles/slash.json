{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aegis:slash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/aegis/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.08,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.18, 0.3)"
      },
      "minecraft:particle_initial_speed": 0.3,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 * (1 - v.particle_age / v.particle_lifetime)",
          "0.22 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, v.color.r, v.particle_age / v.particle_lifetime)",
          "math.lerp(1.0, v.color.g, v.particle_age / v.particle_lifetime)",
          "math.lerp(1.0, v.color.b, v.particle_age / v.particle_lifetime)",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
